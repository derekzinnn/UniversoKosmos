// ═══════════════════════════════════════════════════════════════════════
//  Universo Kosmos — Phase 0 Prisma schema
//
//  Conventions
//  - Tables are snake_case + plural; columns snake_case (@map / @@map).
//    Reason: we write raw SQL for the audit-log triggers, and these tables
//    are read directly in the Supabase dashboard. PascalCase forces quoting.
//  - IDs are UUIDv7: unguessable, but time-ordered, so inserts stay at the
//    right-hand edge of the primary key index instead of splitting pages.
//    Exception: WatchEvent uses a BigInt sequence — it is the only table that
//    grows without bound, and its rows are never addressed individually.
//  - `order` fields map to the column `sort_order`. ORDER is a reserved SQL
//    keyword and would need quoting in every hand-written query.
//  - Two invariants are enforced by the database, not by application code.
//    See prisma/migrations/*_phase0_guarantees/migration.sql:
//      1. audit_logs rejects UPDATE and DELETE (append-only).
//      2. users.role = SUPERADMIN if and only if tenant_id IS NULL.
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy & identity ────────────────────────────────────────────────

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  SUPERADMIN
  CLIENT_OWNER
  CLIENT_MEMBER
}

model Tenant {
  id               String       @id @default(uuid(7))
  name             String
  slug             String       @unique
  status           TenantStatus @default(ONBOARDING)
  contractSignedAt DateTime?    @map("contract_signed_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  users            User[]
  invitations      Invitation[]
  trackAssignments TrackAssignment[]
  lessonProgress   LessonProgress[]
  watchEvents      WatchEvent[]
  hiddenLessons    HiddenLesson[]

  @@index([status])
  @@map("tenants")
}

model User {
  id           String     @id @default(uuid(7))
  tenantId     String?    @map("tenant_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  role         Role
  status       UserStatus @default(ACTIVE)
  /// Object path of the avatar image inside the storage bucket, e.g.
  /// `avatars/<userId>-<uuid>.jpg`. Null falls back to the initials chip. Only
  /// the path is stored; the public URL is derived in the mapper.
  avatarImagePath String? @map("avatar_image_path")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]         @relation("InvitationInvitedBy")
  invitationAccepted  Invitation?          @relation("InvitationAcceptedBy")
  lessonProgress      LessonProgress[]
  watchEvents         WatchEvent[]
  tracksAssigned      TrackAssignment[]    @relation("TrackAssignmentAssignedBy")

  @@index([tenantId])
  @@index([tenantId, role])
  @@map("users")
}

model Invitation {
  id         String    @id @default(uuid(7))
  tenantId   String?   @map("tenant_id")
  email      String
  role       Role
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  invitedByUserId  String? @map("invited_by_user_id")
  acceptedByUserId String? @unique @map("accepted_by_user_id")

  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy      User?   @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedByUser User?   @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([email])
  @@index([expiresAt])
  @@map("invitations")
}

model RefreshToken {
  id                String    @id @default(uuid(7))
  userId            String    @map("user_id")
  familyId          String    @map("family_id")
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @map("replaced_by_token_id")
  userAgent         String?   @map("user_agent")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── Content (schema now, CRUD in Phase 1) ─────────────────────────────

enum ResourceType {
  FILE
  LINK
}

model Track {
  id          String   @id @default(uuid(7))
  slug        String   @unique
  title       String
  description String?
  published   Boolean  @default(false)
  /// Object path of the banner image inside the storage bucket, e.g.
  /// `tracks/<id>/cover-<uuid>.jpg`. The public URL is derived from it and the
  /// configured bucket; the raw path is stored so the bucket can move without a
  /// data migration. Null falls back to the generated orbit cover.
  coverImagePath String? @map("cover_image_path")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  modules     Module[]
  assignments TrackAssignment[]

  @@index([published])
  @@map("tracks")
}

model Module {
  id          String   @id @default(uuid(7))
  trackId     String   @map("track_id")
  title       String
  description String?
  order       Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  track   Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([trackId, order])
  @@index([trackId])
  @@map("modules")
}

model Lesson {
  id              String   @id @default(uuid(7))
  moduleId        String   @map("module_id")
  title           String
  description     String?
  order           Int      @map("sort_order")
  /// The video id at whichever provider is configured. Deliberately not
  /// named after a vendor: the choice has already been revisited more than
  /// once, and a column called `panda_video_id` turns the next revisit into a
  /// migration instead of one new file behind `VideoProvider`.
  externalVideoId String?  @map("external_video_id")
  durationSeconds Int?     @map("duration_seconds")
  isRequired      Boolean  @default(true) @map("is_required")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources   Resource[]
  progress    LessonProgress[]
  watchEvents WatchEvent[]
  hiddenFor   HiddenLesson[]

  @@unique([moduleId, order])
  @@index([moduleId])
  @@map("lessons")
}

model Resource {
  id            String       @id @default(uuid(7))
  lessonId      String       @map("lesson_id")
  type          ResourceType
  title         String
  url           String
  fileSizeBytes Int?         @map("file_size_bytes")
  order         Int          @map("sort_order")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("resources")
}

model TrackAssignment {
  id               String    @id @default(uuid(7))
  trackId          String    @map("track_id")
  tenantId         String    @map("tenant_id")
  assignedByUserId String?   @map("assigned_by_user_id")
  dueAt            DateTime? @map("due_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  track      Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedBy User?  @relation("TrackAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([trackId, tenantId])
  @@index([tenantId])
  @@map("track_assignments")
}

/// A single lesson hidden from one client company.
///
/// The access model is a *denylist*: assigning a track shows every lesson by
/// default (the historical behaviour), and a row here removes one lesson from
/// one tenant's view. Presence means hidden. It carries a denormalised
/// `tenantId` so the tenant guard treats it like every other scoped table —
/// both the client reading their own hidden set and staff configuring it run
/// scoped to the one tenant.
model HiddenLesson {
  id        String   @id @default(uuid(7))
  tenantId  String   @map("tenant_id")
  lessonId  String   @map("lesson_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([tenantId, lessonId])
  @@index([tenantId])
  @@index([lessonId])
  @@map("hidden_lessons")
}

// ─── Progress (schema now, logic in Phase 2) ───────────────────────────

model LessonProgress {
  id                  String    @id @default(uuid(7))
  userId              String    @map("user_id")
  lessonId            String    @map("lesson_id")
  tenantId            String    @map("tenant_id")
  maxPositionSeconds  Int       @default(0) @map("max_position_seconds")
  totalWatchedSeconds Int       @default(0) @map("total_watched_seconds")
  startedAt           DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([tenantId])
  @@index([lessonId])
  @@index([tenantId, completedAt])
  @@map("lesson_progress")
}

model WatchEvent {
  id              BigInt   @id @default(autoincrement())
  userId          String   @map("user_id")
  lessonId        String   @map("lesson_id")
  tenantId        String   @map("tenant_id")
  positionSeconds Int      @map("position_seconds")
  ip              String?
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId, createdAt])
  @@index([tenantId, createdAt])
  @@map("watch_events")
}

// ─── Audit (append-only, no FKs by design) ─────────────────────────────

model AuditLog {
  id          String   @id @default(uuid(7))
  actorUserId String?  @map("actor_user_id")
  actorEmail  String?  @map("actor_email")
  actorRole   Role?    @map("actor_role")
  tenantId    String?  @map("tenant_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
