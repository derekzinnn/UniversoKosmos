NODE_ENV=development

PORT=3333

DATABASE_URL="postgresql://user:password@host:5432/kosmos?schema=public"

DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/kosmos_test?schema=public"

JWT_SECRET="change-me-to-at-least-32-random-characters-please"

ACCESS_TOKEN_TTL_SECONDS=900

REFRESH_TOKEN_TTL_SECONDS=2592000

INVITATION_TTL_SECONDS=604800

PASSWORD_RESET_TTL_SECONDS=3600

# In production this is https://universo.kosmosdigital.com.br
WEB_APP_URL="http://localhost:5173"

# For SameSite=Lax to work, the API and web must share a registrable domain
# (kosmosdigital.com.br). Usually left empty (host-only cookie); see CLAUDE.md.
COOKIE_DOMAIN=

TRUST_PROXY=0

# Email delivery.
#   console — prints the message (and its links) to stdout. The default.
#   resend  — sends over the Resend API. Set RESEND_API_KEY and make sure the
#             domain in EMAIL_FROM is verified in the Resend dashboard.
EMAIL_PROVIDER=console
EMAIL_FROM="Universo Kosmos <nao-responda@kosmosdigital.com.br>"
RESEND_API_KEY=

# Internal alert sent when a client finishes a whole track.
TRACK_COMPLETION_NOTIFY_EMAIL=kosmosinteligenciadigital@gmail.com

VIDEO_PROVIDER=fake

PLAYBACK_URL_TTL_SECONDS=600

HEARTBEAT_INTERVAL_SECONDS=15

LESSON_COMPLETION_RATIO=0.9

MAX_CREDITED_PLAYBACK_SPEED=3

# Image storage for track banners.
#   none     — no uploads; the banner endpoint answers 503. The default.
#   supabase — Supabase Storage. Create a PUBLIC bucket named below, then fill
#              SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY. The key is secret and
#              server-only — never expose it to a browser.
STORAGE_PROVIDER=none
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=track-banners

LOG_LEVEL=info

SEED_ADMIN_EMAIL="admin@kosmos.com.br"
SEED_ADMIN_NAME="Kosmos Admin"
SEED_ADMIN_PASSWORD=
